# ==============================================================================
# EmergeX Backend Configuration (Phase 0 Foundation)
# Copy this file to .env:
#   cp .env.example .env (macOS/Linux) or copy .env.example .env (Windows)
# DO NOT COMMIT REAL SECRETS OR SENSITIVE CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Server Runtime
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS Configuration
# Comma-separated list of allowed web origins for frontend team integration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Application Origin
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Future Phase Integrations (Placeholders - not required for Phase 0)
# ------------------------------------------------------------------------------

# Phase 1: Database (Supabase PostgreSQL + PostGIS)
SUPABASE_URL=
SUPABASE_KEY=

# Phase 2: AI Emergency Triage Service (Sokt / Gemini evaluation)
AI_PROVIDER=sokt
AI_PROVIDER_URL=https://flow.sokt.io/func/scriyzd6Bt0S
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT=8.0
GEMINI_API_KEY=

# Phase 3: Emergency Dispatch / SOS Integration (Twilio / SMS Provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
